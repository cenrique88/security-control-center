NODE_ENV="production"

# Database
POSTGRES_USER="sscc"
POSTGRES_PASSWORD="CAMBIAR_PASSWORD_LARGO"
POSTGRES_DB="sscc"
DATABASE_URL="postgresql://sscc:CAMBIAR_PASSWORD_LARGO@127.0.0.1:5432/sscc?schema=public"

# API
PORT="3001"
JWT_SECRET="CAMBIAR_SECRET_LARGO_ALEATORIO"
CORS_ORIGIN="https://crm.tudominio.com"

# Web
NEXT_PUBLIC_API_URL="https://api.tudominio.com"
INTERNAL_API_URL="http://127.0.0.1:3001"

# Maps / dispatcher
GOOGLE_MAPS_API_KEY=""

# Traccar / GPS
OSRM_BASE_URL=""
OSRM_MAP_MATCHING="true"
OSRM_ALLOW_PUBLIC="false"

# Gmail optional
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REDIRECT_URI="https://api.tudominio.com/api/gmail/oauth/callback"
GMAIL_REFRESH_TOKEN=""
GMAIL_INBOX_QUERY="in:inbox category:primary"

# WhatsApp optional
OPENWA_API_URL=""
OPENWA_SESSION=""
OPENWA_API_KEY=""
OPENWA_WEBHOOK_SECRET=""
OPENWA_SEND_PATH=""
OPERATOR_WHATSAPP_NUMBER=""
MEETING_REMINDER_WHATSAPP_TO=""
